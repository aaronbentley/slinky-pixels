{
    "name": "slinky-pixels",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --experimental-https",
        "build": "next build",
        "start": "next start",
        "preview": "next build && next start",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit",
        "schema:extract": "sanity schema extract --enforce-required-fields --force --path='./src/sanity/extract.json'",
        "schema:generate": "sanity typegen generate",
        "typegen": "yarn schema:extract && yarn schema:generate",
        "schema:manifest": "sanity manifest extract --path public/studio/static"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@sanity/image-url": "2.1.1",
        "@sanity/vision": "6.22.0",
        "@vercel/analytics": "^2.0.1",
        "@wrksz/themes": "^2.1.1",
        "camelcase": "^10.0.0",
        "cn": "^0.5.2",
        "geist": "^1.9.2",
        "lucide-react": "^1.70.0",
        "motion": "^14.10.1",
        "next": "16.4.5",
        "next-sanity": "^13.4.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sanity": "6.22.0",
        "sanity-image": "^1.3.0",
        "styled-components": "6.6.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-is": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "baseline-browser-mapping": "^2.11.35",
        "class-variance-authority": "^0.7.1",
        "eslint": "^10.14.0",
        "eslint-config-next": "16.4.5",
        "eslint-config-prettier": "^10.1.8",
        "postcss": "^8.5.32",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react-is": "^19.3.1",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "packageManager": "yarn@4.18.1",
    "browserslist": {
        "production": [
            "last 2 Chrome versions",
            "last 2 Firefox versions",
            "last 2 Edge versions",
            "last 2 Safari versions"
        ],
        "development": [
            "last 1 Chrome version"
        ]
    }
}
